{% macro banner() -%}
# {{ S_description }} -- generated by dynaform
{%- endmacro %}
{# Starts with its own newline, and renders nothing at all for an empty value,
   so the caller writes {{- env_line(...) }} and an unset value leaves no
   blank line behind. #}
{% macro env_line(name, value) %}
{%- if value %}
Environment={{ name }}={{ value }}
{%- endif %}
{%- endmacro %}
