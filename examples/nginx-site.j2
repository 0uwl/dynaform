{% extends "_base.j2" %}
{% block location %}
{{ super() }}
{% if B_websockets %}
    location /ws {
        proxy_pass http://127.0.0.1:{{ N_port | default(80) }};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
{% endif %}
{% endblock %}
