{% extends "_base.j2" %}
{% block location %}
{{- super() }}
{%- for loc in L_locations | group("Extra locations") %}

    location {{ loc.S_path | placeholder("/api") }} {
        proxy_pass http://127.0.0.1:{{ loc.N_port }};
    }
{%- endfor %}
{%- if B_websockets | label("WebSocket endpoint") | help("Proxies /ws with upgrade headers") %}

    location /ws {
        proxy_pass http://127.0.0.1:{{ N_port | default(80) }};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
{%- endif %}
{%- endblock %}
