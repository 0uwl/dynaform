[Unit]
Description=DynaForm
After=network-online.target dynaform-gitsync.service
Wants=dynaform-gitsync.service

[Container]
Image=ghcr.io/0uwl/dynaform:latest
ContainerName=dynaform

# Reachable from this host only
# See "Deployment security" in the README to know the security implications
# of publishing DynaForm to all interfaces
PublishPort=127.0.0.1:8000:8000

# Backstop for the whole container; each worker is also capped by
# WORKER_MAX_MEMORY_MB (see gunicorn.conf.py).
PodmanArgs=--memory=768m

# ! Required !
# Generate a key with:
#   `openssl rand -base64 32`  
# To keep it out of this file, the README describes handing it to Podman as a secret instead.
Environment=SECRET_KEY=

# Optional gunicorn configurations
Environment=BIND_HOST=[::]
Environment=BIND_PORT=8000
Environment=GUNICORN_WORKERS=2
Environment=GUNICORN_TIMEOUT=10
Environment=WORKER_MAX_MEMORY_MB=256

# Templates come from the volume that dynaform-gitsync fills.
# git-sync publishes each checkout behind a "current" symlink.
Volume=templates.volume:/templates:ro
Environment=TEMPLATE_DIR=/templates/current

[Service]
Restart=on-failure

[Install]
WantedBy=default.target
