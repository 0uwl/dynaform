[Unit]
Description=DynaForm
After=network-online.target

[Container]
Image=ghcr.io/0uwl/dynaform:latest
PublishPort=8000:8000

# ! Required !
# Generate a key with `openssl rand -base64 32` and paste it after the `=`. 
# To keep it out of this file, the README describes handing it to Podman as a secret instead.
Environment=SECRET_KEY=

# Optional gunicorn configurations
Environment=BIND_HOST=[::]
Environment=BIND_PORT=8000
Environment=GUNICORN_WORKERS=2

# An optional host directory for .j2 templates, listed in the picker on
# the home page.
#
# Create the directory first and then uncomment the line:
#
#     mkdir -p ~/.local/share/dynaform/templates
#
#Volume=%h/.local/share/dynaform/templates:/templates:ro,Z


[Service]
Restart=on-failure

[Install]
WantedBy=default.target
